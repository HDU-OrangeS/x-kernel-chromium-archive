index 37ae4e1bf..2d9b31ebd 100644
--- a/mm/alloc-engine/src/buddy_alloc.rs
+++ b/mm/alloc-engine/src/buddy_alloc.rs
@@ -457,6 +457,72 @@ impl<const PAGE_SIZE: usize> BuddyAllocator<PAGE_SIZE> {
         Err(AllocError::NoMemory)
     }
 
+    /// Allocate a rounded contiguous chunk wholly below an exclusive address limit.
+    ///
+    /// The limit is in the same address space as registered regions. Both the
+    /// requested pages and buddy rounding must fit. Ineligible free chunks stay
+    /// available to other allocations; a limit inside a larger free chunk may
+    /// still allow its lower subchunk to be split and returned.
+    ///
+    /// # Errors
+    ///
+    /// Uses the count/alignment validation of [`Self::allocate_pages`]. Returns
+    /// `NoMemory` when no eligible chunk exists, without consuming other pages.
+    pub fn allocate_pages_below(
+        &mut self,
+        count: usize,
+        align_pow2: usize,
+        end_exclusive: usize,
+    ) -> AllocResult<usize> {
+        let order = allocation_order(count)?;
+        let align = if align_pow2 == 0 {
+            PAGE_SIZE
+        } else {
+            align_pow2
+        };
+        if !align.is_power_of_two() || align < PAGE_SIZE {
+            return Err(AllocError::InvalidInput);
+        }
+        let bytes = order_size::<PAGE_SIZE>(order);
+        for region in self.regions[..self.region_count].iter_mut().flatten() {
+            if region.heap_start >= end_exclusive {
+                continue;
+            }
+            if region.usable_end <= end_exclusive {
+                if let Some(address) =
+                    Self::alloc_aligned::<PAGE_SIZE>(region, order, align / PAGE_SIZE)
+                {
+                    return Ok(address);
+                }
+                continue;
+            }
+            // Only a region crossing the limit needs a constrained scan. Do
+            // not allocate and reject a high head: doing so can repeatedly
+            // select that same head while a usable lower chunk remains free.
+            for source_order in order..=MAX_ORDER {
+                let candidate = region.free_lists[source_order]
+                    .iter()
+                    .map(|node| node as *const FreeNode as usize)
+                    .find(|address| {
+                        address.is_multiple_of(align)
+                            && address
+                                .checked_add(bytes)
+                                .is_some_and(|end| end <= end_exclusive)
+                    });
+                if let Some(address) = candidate {
+                    assert!(region.remove_free::<PAGE_SIZE>(address, source_order));
+                    return Ok(region.split_for_target::<PAGE_SIZE>(
+                        address,
+                        source_order,
+                        address,
+                        order,
+                    ));
+                }
+            }
+        }
+        Err(AllocError::NoMemory)
+    }
+
