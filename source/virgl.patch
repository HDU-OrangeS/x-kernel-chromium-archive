+#[def_test]
+fn bounded_allocation_skips_high_free_head_without_consuming_it() {
+    let mut fixture = Fixture::new(32, 32);
+    let base = fixture.backing.base();
+    for page in 0..32 {
+        fixture
+            .allocator
+            .allocate_pages_at(base + page * PAGE, 1, PAGE)
+            .unwrap();
+    }
+    fixture.allocator.deallocate_pages(base, 1);
+    fixture.allocator.deallocate_pages(base + 16 * PAGE, 1);
+    assert_eq!(
+        fixture
+            .allocator
+            .allocate_pages_below(1, PAGE, base + 8 * PAGE),
+        Ok(base)
+    );
+    assert_eq!(fixture.allocator.available_pages(), 1);
+    assert_eq!(
+        fixture.allocator.allocate_pages(1, PAGE),
+        Ok(base + 16 * PAGE)
