+    /// Returns whether any CPU-driven timer has a pending deadline.
+    ///
+    /// The owning runtime uses this under its timer mutex before sampling
+    /// thread-group CPU time. Notification-free POSIX timers also advance
+    /// their deadlines when polled, so their notification mode is immaterial.
+    pub fn has_armed_cpu_timers(&self) -> bool {
+        self.itimers[ITIMER_VIRTUAL_INDEX].deadline().is_some()
+            || self.itimers[ITIMER_PROF_INDEX].deadline().is_some()
+            || self
+                .posix_timers
+                .values()
+                .any(PosixTimer::is_armed_process_cpu)
+    }
