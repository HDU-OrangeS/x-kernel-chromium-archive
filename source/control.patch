+        .try_reserve_exact(members.len())
+        .map_err(|_| KError::NoMemory)?;
+    for member in members {
+        spaces.push(member.upgrade().ok_or(KError::WouldBlock)?);
+    }
+    let mut guards = Vec::new();
+    guards
+        .try_reserve_exact(spaces.len())
+        .map_err(|_| KError::NoMemory)?;
+    for space in &spaces {
+        // The registry is unlocked here. A contended MM ends this attempt,
+        // rather than waiting while already holding other MM locks.
+        guards.push(space.try_lock().ok_or(KError::WouldBlock)?);
+    }
+    let captured = capture(&guards)?;
+    let membership_unchanged = ACTIVE_USER_ADDRESS_SPACES
+        .try_lock()
+        .is_some_and(|registry| registry.epoch == epoch);
+    drop(guards);
+    if membership_unchanged {
+        Ok(captured)
+    } else {
+        Err(KError::WouldBlock)
+    }
