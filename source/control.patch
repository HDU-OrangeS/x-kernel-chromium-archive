+#[derive(Clone, Copy)]
+enum SmapsView {
+    PerArea,
+    Rollup,
+}
+
+struct SmapsEntry {
+    mapping: MapsEntry,
+    size_kib: Option<usize>,
+    rss_kib: usize,
+    pss_kib: u64,
+}
+
+impl SmapsEntry {
+    fn for_area(area: memspace::ResidentPssArea, heap_top: usize) -> Self {
+        let mut mapping = MapsEntry::from_vma(&area.vma, heap_top);
+        // A mapped filename must not introduce another stats field.
+        if let Some(path) = &mut mapping.path
+            && path.contains(['\n', '\r'])
+        {
+            *path = path.replace('\n', r"\012").replace('\r', r"\015");
+        }
+        Self {
+            size_kib: Some((mapping.end - mapping.start) / 1024),
+            mapping,
+            rss_kib: area.resident_bytes / 1024,
+            pss_kib: area.pss_kib,
+        }
+    }
+
+    fn rollup(snapshot: &memspace::ResidentPssSnapshot) -> Self {
+        let start = snapshot
+            .areas
+            .first()
+            .map_or(0, |area| area.vma.start().as_usize());
+        let end = snapshot
+            .areas
+            .last()
+            .map_or(0, |area| area.vma.end().as_usize());
+        Self {
+            mapping: MapsEntry {
+                start,
+                end,
+                flags: MappingFlags::empty(),
+                offset: 0,
+                inode: 0,
+                path: None,
+                name: Some("[rollup]"),
+            },
+            size_kib: None,
+            rss_kib: snapshot.resident_bytes / 1024,
+            pss_kib: snapshot.pss_kib,
+        }
+    }
+
+    fn show(&self, buf: &mut String) -> core::fmt::Result {
+        buf.push_str(&render_maps_line(&self.mapping));
+        if let Some(size_kib) = self.size_kib {
+            writeln!(buf, "Size:           {size_kib:>8} kB")?;
+        }
+        writeln!(buf, "Rss:            {:>8} kB", self.rss_kib)?;
+        writeln!(buf, "Pss:            {:>8} kB", self.pss_kib)
+    }
+}
+
+struct SmapsIter {
+    entries: Vec<SmapsEntry>,
+    next_index: usize,
+}
+
+impl SmapsIter {
+    fn new(task_weak: &WeakKtaskRef, view: SmapsView) -> VfsResult<Self> {
+        // The scan can visit other processes' address spaces. Authorize the
+        // current userspace opener before acquiring the target mm capability.
+        if current().try_as_thread().is_none() || current_cred().fsuid() != 0 {
+            return Err(VfsError::PermissionDenied);
+        }
+        let task = upgrade_task(task_weak)?;
+        let process = task.as_thread().process();
+        let aspace = process.address_space()?;
+        let heap_top = process.heap_top()?;
+        // Leave the target lock before the scan. Keep its lifetime capability
+        // until the provider has finished collecting the owned snapshot.
+        let mm_id = aspace.lock().mm_id();
+        let snapshot = memspace::resident_pss_snapshot(mm_id)?;
+        drop(aspace);
+        let entries = match view {
+            SmapsView::PerArea => snapshot
+                .areas
+                .into_iter()
+                .map(|area| SmapsEntry::for_area(area, heap_top))
+                .collect(),
+            SmapsView::Rollup => vec![SmapsEntry::rollup(&snapshot)],
+        };
+        Ok(Self {
+            entries,
+            next_index: 0,
+        })
+    }
+}
+
+impl SeqIterator for SmapsIter {
+    type Item = usize;
+
+    fn rewind(&mut self) {
+        self.next_index = 0;
+    }
+
+    fn start(&mut self) -> Option<Self::Item> {
+        self.rewind();
+        self.next()
+    }
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let index = self.next_index;
+        if index == self.entries.len() {
+            return None;
+        }
+        self.next_index += 1;
+        Some(index)
+    }
+
+    fn show(&self, item: &Self::Item, buf: &mut String) -> core::fmt::Result {
+        self.entries[*item].show(buf)
+    }
+}
