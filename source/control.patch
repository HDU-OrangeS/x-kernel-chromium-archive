+    let (epoch, members) = {
+        let registry = ACTIVE_USER_ADDRESS_SPACES
+            .try_lock()
+            .ok_or(KError::WouldBlock)?;
+        if registry.epoch == u64::MAX {
+            return Err(KError::WouldBlock);
