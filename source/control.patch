+
+#[derive(Clone, Copy)]
+struct PhysicalSpan {
+    first_pfn: usize,
+    end_pfn: usize,
+}
+
+fn collect_spans(
+    spans: &mut Vec<PhysicalSpan>,
+    enumerate: impl FnOnce(&mut dyn FnMut(VirtAddr, PhysAddr, usize)) -> KResult<()>,
+) -> KResult<()> {
+    let start_index = spans.len();
+    let mut copied = Ok(());
+    enumerate(&mut |_, physical, bytes| {
+        if copied.is_ok() {
+            copied = append_span(spans, start_index, physical, bytes);
+        }
+    })?;
+    copied
+}
+
+fn append_span(
+    spans: &mut Vec<PhysicalSpan>,
+    start_index: usize,
+    physical: PhysAddr,
+    bytes: usize,
+) -> KResult<()> {
+    let start = physical.as_usize();
+    if bytes == 0 || !start.is_multiple_of(PAGE_SIZE_4K) || !bytes.is_multiple_of(PAGE_SIZE_4K) {
+        return Err(KError::BadAddress);
+    }
+    let first_pfn = start / PAGE_SIZE_4K;
+    let end_pfn = start.checked_add(bytes).ok_or(KError::BadAddress)? / PAGE_SIZE_4K;
+    // Adjacent physical intervals may be merged within the same walk. Do not
+    // merge aliases or cross boundaries recorded for the target VMAs.
+    if spans.len() > start_index
+        && let Some(previous) = spans.last_mut()
+        && previous.end_pfn == first_pfn
+    {
+        previous.end_pfn = end_pfn;
+        return Ok(());
+    }
+    spans.try_reserve(1).map_err(|_| KError::NoMemory)?;
+    spans.push(PhysicalSpan { first_pfn, end_pfn });
+    Ok(())
+}
+
+struct ShareBoundary {
+    pfn: usize,
+    mapped_pages_before: usize,
+    fixed_bytes_before: u128,
+    fixed_bytes_per_page: u128,
+}
+
+impl ShareBoundary {
+    fn totals_at(&self, pfn: usize) -> (usize, u128) {
+        let pages = pfn - self.pfn;
+        (
+            self.mapped_pages_before
+                + if self.fixed_bytes_per_page != 0 {
+                    pages
+                } else {
+                    0
+                },
+            self.fixed_bytes_before + (pages as u128) * self.fixed_bytes_per_page,
+        )
+    }
+}
+
+struct ShareIndex(Vec<ShareBoundary>);
+
+impl ShareIndex {
+    fn new(spans: &[PhysicalSpan]) -> KResult<Self> {
+        let mut edges = Vec::new();
+        let capacity = spans.len().checked_mul(2).ok_or(KError::NoMemory)?;
+        edges
+            .try_reserve_exact(capacity)
+            .map_err(|_| KError::NoMemory)?;
+        for span in spans {
+            edges.push((span.first_pfn, 1i64));
+            edges.push((span.end_pfn, -1i64));
+        }
+        edges.sort_unstable_by_key(|&(pfn, _)| pfn);
+        let mut boundaries: Vec<ShareBoundary> = Vec::new();
+        let mut mapcount = 0i64;
+        let mut rest = edges.as_slice();
+        while let Some(&(pfn, _)) = rest.first() {
+            let batch = rest.partition_point(|&(next, _)| next == pfn);
+            let change: i64 = rest[..batch].iter().map(|&(_, delta)| delta).sum();
+            rest = &rest[batch..];
+            if change == 0 {
+                continue;
+            }
+            mapcount = mapcount.checked_add(change).ok_or(KError::BadAddress)?;
+            if mapcount < 0 {
+                return Err(KError::BadAddress);
+            }
+            let (mapped_pages_before, fixed_bytes_before) = boundaries
+                .last()
+                .map_or((0, 0), |boundary| boundary.totals_at(pfn));
+            let fixed_bytes_per_page = if mapcount == 0 {
+                0
+            } else {
+                // A zero share would lose the distinction between a hole
+                // and a mapped PFN. Reject counts beyond fixed-point precision.
+                let share = ((PAGE_SIZE_4K as u128) << PSS_SHIFT) / mapcount as u128;
+                if share == 0 {
+                    return Err(KError::InvalidInput);
+                }
+                share
+            };
+            boundaries.try_reserve(1).map_err(|_| KError::NoMemory)?;
+            boundaries.push(ShareBoundary {
+                pfn,
+                mapped_pages_before,
+                fixed_bytes_before,
+                fixed_bytes_per_page,
+            });
+        }
+        if mapcount != 0 {
+            return Err(KError::BadAddress);
+        }
+        Ok(Self(boundaries))
+    }
+
+    fn totals_at(&self, pfn: usize) -> (usize, u128) {
+        let after = self.0.partition_point(|boundary| boundary.pfn <= pfn);
+        after
+            .checked_sub(1)
+            .map_or((0, 0), |i| self.0[i].totals_at(pfn))
+    }
+
+    fn share(&self, span: PhysicalSpan) -> KResult<(usize, u128)> {
+        let (start_pages, start_fixed) = self.totals_at(span.first_pfn);
+        let (end_pages, end_fixed) = self.totals_at(span.end_pfn);
+        let pages = end_pages - start_pages;
+        if pages != span.end_pfn - span.first_pfn {
+            return Err(KError::BadAddress);
+        }
+        Ok((pages * PAGE_SIZE_4K, end_fixed - start_fixed))
+    }
+}
+
+fn mapping_metadata(vma: &VmArea) -> KResult<VmArea> {
+    let file = if let Some(info) = vma.file_mapping() {
+        let path = if let Some(original) = &info.path {
+            let mut copy = String::new();
+            copy.try_reserve_exact(original.len())
+                .map_err(|_| KError::NoMemory)?;
+            copy.push_str(original);
+            Some(copy)
+        } else {
+            None
+        };
+        Some(FileMappingInfo {
+            offset: info.offset,
+            inode: info.inode,
+            path,
+        })
+    } else {
+        None
+    };
+    Ok(VmArea::new(
+        vma.start(),
+        vma.size(),
+        vma.flags(),
+        vma.max_flags(),
+        vma.backing(),
+        vma.page_offset(),
+        file,
+    ))
+}
+
+/// Captures an address space's PSS from all active user mappings.
+///
+/// Call from task context without MM or mapping-owner locks. Simultaneous
+/// aliases count separately while all tasks sharing one MM count just once.
+/// The scan only copies span identities and mapping metadata under locks.
+/// Sorting, division and output construction run after the locks are released.
+/// Physical identities are never exported or dereferenced.
+///
+/// # Errors
+///
+/// Returns `WouldBlock` on a competing mutation or contended scan, and
+/// `NoSuchProcess` when the MM is no longer registered. Incomplete captures,
+/// malformed spans and allocation errors return an error instead of a partial
+/// PSS value.
+pub fn resident_pss_snapshot(mm_id: u64) -> KResult<ResidentPssSnapshot> {
+    let (spans, metadata) = with_frozen_user_address_spaces(|spaces| {
+        let mut spans = Vec::new();
+        let mut metadata: Vec<(VmArea, Range<usize>)> = Vec::new();
+        let mut found = false;
+        for mm in spaces {
+            if mm.mm_id() != mm_id {
+                collect_spans(&mut spans, |visit| mm.visit_resident_spans(visit))?;
+                continue;
+            }
+            found = true;
+            for vma in mm
+                .vmas()
+                .filter(|vma| vma.max_flags().contains(MappingFlags::USER))
+            {
+                let begin = spans.len();
+                collect_spans(&mut spans, |visit| mm.visit_vma_resident_spans(vma, visit))?;
+                metadata.try_reserve(1).map_err(|_| KError::NoMemory)?;
+                metadata.push((mapping_metadata(vma)?, begin..spans.len()));
+            }
+        }
+        if !found {
+            return Err(KError::NoSuchProcess);
+        }
+        Ok((spans, metadata))
+    })?;
+    let mapcounts = ShareIndex::new(&spans)?;
+    let mut areas = Vec::new();
+    areas
+        .try_reserve_exact(metadata.len())
+        .map_err(|_| KError::NoMemory)?;
+    let mut resident_bytes = 0usize;
+    let mut fixed_bytes = 0u128;
+    for (vma, span_range) in metadata {
+        let mut rss = 0usize;
+        let mut pss = 0u128;
+        for &span in &spans[span_range] {
+            let (mapped, share) = mapcounts.share(span)?;
+            rss = rss.checked_add(mapped).ok_or(KError::InvalidInput)?;
+            pss += share;
+        }
+        if rss > vma.size() {
+            return Err(KError::BadAddress);
+        }
+        areas.push(ResidentPssArea {
+            vma,
+            resident_bytes: rss,
+            pss_kib: to_kib(pss)?,
+        });
+        resident_bytes = resident_bytes
+            .checked_add(rss)
+            .ok_or(KError::InvalidInput)?;
+        fixed_bytes += pss;
+    }
+    Ok(ResidentPssSnapshot {
+        areas,
+        resident_bytes,
+        pss_kib: to_kib(fixed_bytes)?,
+    })
+}
+
+fn to_kib(fixed_bytes: u128) -> KResult<u64> {
+    u64::try_from(fixed_bytes >> (PSS_SHIFT + 10)).map_err(|_| KError::InvalidInput)
+}
+
+#[cfg(unittest)]
+mod tests {
+    use unittest::def_test;
+
+    use super::*;
+
+    #[def_test]
+    fn physical_aliases_split_a_span_and_round_once() {
+        let full = PhysicalSpan {
+            first_pfn: 32,
+            end_pfn: 36,
+        };
+        let last = PhysicalSpan {
+            first_pfn: 35,
+            end_pfn: 36,
+        };
+        let index = ShareIndex::new(&[full, full, full, last]).unwrap();
+        let (rss, pss) = index.share(full).unwrap();
+        assert_eq!(rss, 16 * 1024);
+        assert_eq!(to_kib(pss).unwrap(), 4);
+        let (_, last_share) = index.share(last).unwrap();
+        assert_eq!(to_kib(last_share).unwrap(), 1);
+        let hole = PhysicalSpan {
+            first_pfn: 31,
+            end_pfn: 33,
+        };
+        assert!(index.share(hole).is_err());
+    }
+}
